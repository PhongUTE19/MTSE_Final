{
  "name": "student-handbook-",
  "version": "1.0.0",
  "description": "SpendWise - AI Expense Management & Knowledge Base Assistant",
  "type": "module",
  "scripts": {
    "dev": "npm start",
    "start": "concurrently -n \"server,client\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "server": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "index": "npm --prefix server run index",
    "set-role": "node server/scripts/set-user-role.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "test:unit": "node --test \"tests/unit/**/*.test.js\"",
    "test:integration": "node --test \"tests/integration/**/*.test.js\"",
    "eval:rag": "node evals/rag/runner.js",
    "test:all": "npm test && npm run eval:rag",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:index": "docker compose exec server npm run index",
    "install:all": "npm install && npm --prefix server install && npm --prefix client install"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}