# Server Configuration
PORT=3000

# Google Gemini API Key (Required)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Models
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_RECEIPT_MODEL=gemini-3.5-flash-lite
EMBEDDING_MODEL=gemini-embedding-001

# Qdrant Cloud Configuration (Required)
QDRANT_URL=https://your-cluster-id.region.gcp.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_cloud_api_key_here
QDRANT_COLLECTION_NAME=your_qdrant_collection_name_here

# Supabase Configuration (Required)
SUPABASE_URL=https://your-project.supabase.co
# Public anon key used by the server only to create RLS-aware clients with
# the caller's Bearer token. It is not a service-role credential.
SUPABASE_ANON_KEY=your_public_anon_key_here
SUPABASE_SECRET_KEY=your_supabase_secret_key_here

# RAG Settings
TOP_K=3
SIMILARITY_THRESHOLD=0.60
